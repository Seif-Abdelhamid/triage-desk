# Copy to .env and fill in. Never commit .env.

# Shared secret configured on the GitHub webhook. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Fine-grained PAT or GitHub App installation token, scoped to the target repos only:
#   Pull requests: read & write, Contents: read, Metadata: read
GITHUB_TOKEN=
# Login the bot posts as; its own comments are ignored to avoid loops.
BOT_LOGIN=
GITHUB_API_URL=https://api.github.com

POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triage
DATABASE_URL=postgresql+psycopg://triage:change-me@postgres:5432/triage
REDIS_URL=redis://redis:6379/0

# Semgrep registry ruleset or a path to a local rules file
SEMGREP_CONFIG=p/default
SEMGREP_TIMEOUT_S=300
MAX_FILES_PER_SCAN=200
MAX_FILE_BYTES=1000000
TASK_HARD_LIMIT_S=900
TARGET_TASKS_PER_WORKER=2
CORS_ORIGINS=http://localhost:5173
